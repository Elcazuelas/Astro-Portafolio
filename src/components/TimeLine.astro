---
import TimeLineItem from "./TimeLineItem.astro";
type Experience = {
    date: string;
    title: string;
    description: string;
}
const experience: Experience[] = [
    {
        date: "mayo 2025 – actualidad",
        title: "Ingeniero de Datos - DGAI · Universidad del Bío-Bío",
        description: `• Desarrollé indicadores bibliométricos y cienciométricos para hacer seguimiento a la producción científica.
• Automatizé reportes de Power BI con actualización programada para equipos directivos.
• Integré y normalicé datos desde múltiples fuentes (WoS, Scopus, OpenAlex, Crossref, PlumX) mediante procesos ETL.
• Diseñé tableros ejecutivos para la alta dirección y las facultades.
• Creé herramientas de software a medida para apoyar las necesidades analíticas de la unidad.`,
    },
    {
        date: "diciembre 2025 – enero 2026",
        title: "Desarrollador Full Stack (por proyecto) · Universidad del Bío-Bío",
        description: `• Lideré el análisis de requerimientos y el diseño de la solución para una herramienta interna.
• Desarrollé el backend usando Python con el framework FastAPI.
• Diseñé y administré una base de datos SQLite para almacenamiento liviano.
• Construí una aplicación de escritorio usando Electron y React.`,
    },
    {
        date: "julio 2025 – octubre 2025",
        title: "Desarrollador Full Stack (por proyecto) · Universidad del Bío-Bío",
        description: `• Recopilé y analicé requerimientos funcionales en colaboración con las partes interesadas.
• Diseñé y desarrollé servicios backend usando Node.js y TypeScript con arquitectura DDD.
• Creé y administré bases de datos PostgreSQL para almacenamiento persistente.
• Construí una aplicación móvil multiplataforma usando Ionic, Capacitor y React.
• Desplegué la aplicación a producción y di soporte a las pruebas de aceptación de usuarios.
• Integré servicios de Firebase y publiqué la app en Google Play (canal de pruebas).`,
    },
    {
        date: "agosto 2022 – diciembre 2024",
        title: "Ayudante a la enseñanza en laboratorios Centrales de Computación en Universidad del Bío-Bío",
        description: `Se realizan actividades de mantención y gestión de equipos computacionales dentro de los laboratorios de computación, además de atender las necesidades de la comunidad universitaria.`,
    },
    {
        date: "septiembre 2024 – diciembre 2024",
        title: "Ayudante Sistemas Operativos en Universidad del Bío-Bío",
        description: `Bajo la coordinación del docente ayudé a la revisión de tareas y trabajos de la asignatura.`,
    },
    {
        date: "marzo 2023 – julio 2024",
        title: "Ayudante Fundamentos para Ciencias de la Computación en Universidad del Bío-Bío",
        description: `Realicé ayudantías a estudiantes, brindando las oportunidades para desarrollar lo aprendido en clases y resolver dudas. También ayudé a revisar actividades y tareas de la asignatura.`,
    },
    {
        date: "noviembre 2023 – diciembre 2023",
        title: "Desarrollador en Unidad de Desarrollo Universidad del Bío-Bío",
        description: `Aporté como desarrollador en un equipo, específicamente en la creación de un módulo para la intranet de la Universidad del Bío-Bío, donde trabajé con la librería mxGraph en JavaScript y PHP para lógica de negocio.`,
    }
];
---
<ol class="relative border-s border-gray-200 dark:border-gray-700">                  
    {experience.map((experience) => (
        <TimeLineItem date={experience.date} title={experience.title} description={experience.description} />
    ))}
</ol>

