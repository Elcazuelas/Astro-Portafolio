---
import "../styles/global.css";
import Side from "../components/Side.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Julio Monroy | Ingeniero Civil en Informática</title>
		<ClientRouter />
	</head>
	<body class="bg-linear-to-b bg-fixed from-slate-700 to-slate-950">
		<div
			class="sm:hidden fixed z-6 top-0 left-0 w-full h-auto bg-linear-to-t from-transparent to-slate-900"
		>
			<button
				id="aside-target"
				type="button"
				class="inline-flex items-center p-2 mt-2 ms-3 text-sm text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
			>
				<span class="sr-only">Open sidebar</span>
				<svg
					class="w-6 h-6"
					aria-hidden="true"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						clip-rule="evenodd"
						fill-rule="evenodd"
						d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"
					></path>
				</svg>
			</button>
		</div>
		<div class="flex ps-2">
			<aside
				id="aside"
				class="fixed sm:sticky top-0 left-0 lg:left-30 z-40 w-64 transition-all duration-200 h-screen sm:flex flex-col hidden bg-linear-to-b bg-fixed from-slate-700 to-slate-950 sm:bg-none"
			>
				<button
					id="close-aside"
					type="button"
					class="inline-flex items-center p-2 mt-2 ms-3 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
				>
					<span class="sr-only">Open sidebar</span>
					<svg
						class="w-6 h-6"
						aria-hidden="true"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							clip-rule="evenodd"
							fill-rule="evenodd"
							d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"
						></path>
					</svg>
				</button>
				<Side />
			</aside>
			<button
				id="menu-backdrop"
				type="button"
				aria-label="Cerrar menú"
				class="fixed inset-0 z-30 hidden bg-slate-950/20 sm:hidden"
			></button>
			<main
				id="main"
				class="flex-1 pe-2 lg:ms-94 sm:ms-64 lg:me-30 sm:mt-25 mt-10 transition-all duration-200"
			>
				<div class="relative grid grid-cols-6 sm:grid-cols-12 gap-3">
					<div
						class="sm:col-span-10 sm:col-start-2 col-span-4 col-start-2 flex flex-col"
					>
						<slot />
					</div>
				</div>
			</main>
		</div>
	</body>
</html>

<script>
	const MOBILE_BREAKPOINT = 640;
	const ACTIVE_SECTION_OFFSET = 96;

	const initSectionNavHighlight = () => {
		const navLinks = Array.from(document.querySelectorAll(".nav-link"));

		if (!navLinks.length) {
			return;
		}

		const previousCleanup = (window as Window & { __sectionNavCleanup?: () => void })
			.__sectionNavCleanup;
		if (previousCleanup) previousCleanup();

		const controller = new AbortController();
		const { signal } = controller;

		const sectionsByHash = new Map<string, HTMLElement>();

		navLinks.forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			const sectionId = link.hash.replace("#", "");
			if (!sectionId) return;
			const section = document.getElementById(sectionId);
			if (section) sectionsByHash.set(link.hash, section);
		});

		const sectionEntries = Array.from(sectionsByHash.entries());

		const setActiveHash = (activeHash: string) => {
			navLinks.forEach((link) => {
				if (!(link instanceof HTMLAnchorElement)) return;
				const samePath = new URL(link.href).pathname === window.location.pathname;
				const isActive = samePath && link.hash === activeHash;
				link.dataset.active = isActive ? "true" : "false";
				if (isActive) {
					link.setAttribute("aria-current", "true");
					return;
				}
				link.removeAttribute("aria-current");
			});
		};

		const getActiveHashFromScroll = () => {
			let activeHash = sectionEntries[0]?.[0] || "";

			sectionEntries.forEach(([hash, section]) => {
				if (section.getBoundingClientRect().top <= ACTIVE_SECTION_OFFSET) {
					activeHash = hash;
				}
			});

			return activeHash;
		};

		const initialHash = window.location.hash || "#projects";
		setActiveHash(initialHash);

		if (!sectionsByHash.size) {
			(window as Window & { __sectionNavCleanup?: () => void }).__sectionNavCleanup = () => {
				controller.abort();
			};
			return;
		}

		let ticking = false;
		const scheduleActiveUpdate = () => {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(() => {
				ticking = false;
				const activeHash = getActiveHashFromScroll();
				if (activeHash) setActiveHash(activeHash);
			});
		};

		document.addEventListener(
			"click",
			(event) => {
				const targetLink = (event.target as HTMLElement).closest(".nav-link");
				if (!(targetLink instanceof HTMLAnchorElement)) return;
				if (new URL(targetLink.href).pathname !== window.location.pathname) return;
				setActiveHash(targetLink.hash);
			},
			{ signal }
		);

		window.addEventListener(
			"scroll",
			scheduleActiveUpdate,
			{ signal, passive: true }
		);

		document.addEventListener(
			"scroll",
			scheduleActiveUpdate,
			{ signal, passive: true, capture: true }
		);

		window.addEventListener(
			"resize",
			scheduleActiveUpdate,
			{ signal }
		);

		scheduleActiveUpdate();

		window.addEventListener(
			"hashchange",
			() => {
				setActiveHash(window.location.hash || "#projects");
			},
			{ signal }
		);

		(window as Window & { __sectionNavCleanup?: () => void }).__sectionNavCleanup = () => {
			controller.abort();
		};
	};

	const initScrollReveal = () => {
		const previousCleanup = (window as Window & { __revealCleanup?: () => void }).__revealCleanup;
		if (previousCleanup) previousCleanup();

		const elements = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
		if (!elements.length) return;

		const controller = new AbortController();
		const { signal } = controller;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				});
			},
			{
				threshold: 0.2,
				rootMargin: "0px 0px -8% 0px",
			}
		);

		elements.forEach((element) => observer.observe(element));

		const cleanup = () => {
			controller.abort();
			observer.disconnect();
		};

		window.addEventListener("beforeunload", cleanup, { signal });
		(window as Window & { __revealCleanup?: () => void }).__revealCleanup = cleanup;
	};

	const initMobileMenu = () => {
		const asideTarget = document.querySelector("#aside-target");
		const aside = document.querySelector("#aside");
		const main = document.querySelector("#main");
		const closeAside = document.querySelector("#close-aside");
		const menuBackdrop = document.querySelector("#menu-backdrop");

		if (
			!(asideTarget instanceof HTMLElement) ||
			!(aside instanceof HTMLElement) ||
			!(main instanceof HTMLElement) ||
			!(closeAside instanceof HTMLElement) ||
			!(menuBackdrop instanceof HTMLElement)
		) {
			return;
		}

		const previousCleanup = (window as Window & { __menuCleanup?: () => void })
			.__menuCleanup;
		if (previousCleanup) previousCleanup();

		const controller = new AbortController();
		const { signal } = controller;

		const isOpen = () => !aside.classList.contains("hidden");

		const openAside = () => {
			aside.classList.remove("hidden");
			aside.classList.add("flex");
			menuBackdrop.classList.remove("hidden");
			main.classList.add("blur-sm");
			main.classList.add("pointer-events-none");
		};

		const closeAsideFn = () => {
			aside.classList.add("hidden");
			aside.classList.remove("flex");
			menuBackdrop.classList.add("hidden");
			main.classList.remove("blur-sm");
			main.classList.remove("pointer-events-none");
		};

		const toggleAside = () => {
			if (isOpen()) {
				closeAsideFn();
				return;
			}
			openAside();
		};

		asideTarget.addEventListener(
			"click",
			(event) => {
				event.stopPropagation();
				toggleAside();
			},
			{ signal }
		);

		closeAside.addEventListener(
			"click",
			(event) => {
				event.stopPropagation();
				closeAsideFn();
			},
			{ signal }
		);

		menuBackdrop.addEventListener(
			"click",
			closeAsideFn,
			{ signal }
		);

		document.addEventListener(
			"click",
			(event) => {
				if (!event.target) return;
				if (
					!aside.contains(event.target as Node) &&
					!asideTarget.contains(event.target as Node) &&
					isOpen()
				) {
					closeAsideFn();
				}
			},
			{ signal }
		);

		aside.addEventListener(
			"click",
			(event) => {
				if (window.innerWidth >= MOBILE_BREAKPOINT) return;
				if ((event.target as HTMLElement).closest("a")) {
					closeAsideFn();
				}
			},
			{ signal }
		);

		window.addEventListener(
			"resize",
			() => {
				if (window.innerWidth >= MOBILE_BREAKPOINT) {
					menuBackdrop.classList.add("hidden");
					main.classList.remove("blur-sm");
					main.classList.remove("pointer-events-none");
				}
			},
			{ signal }
		);

		(window as Window & { __menuCleanup?: () => void }).__menuCleanup = () => {
			controller.abort();
		};
	};

	document.addEventListener("astro:page-load", initMobileMenu);
	document.addEventListener("astro:page-load", initSectionNavHighlight);
	document.addEventListener("astro:page-load", initScrollReveal);
	initMobileMenu();
	initSectionNavHighlight();
	initScrollReveal();
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		color: white;
		font-family: sans-serif;
		scroll-behavior: smooth;
		overflow-y: auto;
		scroll-snap-type: y proximity;
		scroll-padding-top: 6rem;
	}
	
	html {
		background: #0f172a;
	}
</style>
